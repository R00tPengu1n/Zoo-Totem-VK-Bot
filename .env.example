# Ключ доступа сообщества VK: Управление → Работа с API → Ключи доступа.
# Права: управление сообществом, сообщения сообщества, фотографии.
VK_TOKEN=your_vk_community_token

# Сотрудник, которому бот пересылает вопросы: числовой id или короткое имя
# из адреса страницы (vk.com/durov → durov).
# Этот пользователь должен хотя бы раз написать сообществу.
ADMIN_VK_ID=your_vk_screen_name

# Публичная ссылка на диалог с ботом — она уходит в кнопку «Поделиться».
# Формат: https://vk.me/<короткое имя сообщества>
BOT_LINK=https://vk.me/your_community

# Необязательные настройки (ниже значения по умолчанию)
# GUARDIANSHIP_URL=https://moscowzoo.ru/my-zoo/become-a-guardian/
# CONTACT_EMAIL=zoofriends@moscowzoo.ru
# DATABASE_URL=sqlite+aiosqlite:///storage/bot.db
# LOG_LEVEL=INFO
# SLOW_HANDLER_THRESHOLD=2.0
